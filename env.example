# Copy to .env.local for local development, or set these on your host (Vyre: set_env).

# ── Required in production ────────────────────────────────────────────────
# Password for the admin dashboard at /admin
ADMIN_PASSWORD=change-me-to-something-long
# Optional: separate secret for signing admin sessions (defaults to one derived from the password)
ADMIN_SESSION_SECRET=

# Public site URL (used for canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://emiliscleaningco.com

# ── Storage ───────────────────────────────────────────────────────────────
# Recommended: a Postgres database (Neon, Supabase, Render…). Tables are created automatically.
DATABASE_URL=
# Without DATABASE_URL, data is stored on disk here (must be a persistent volume in Docker)
DATA_DIR=./data

# ── Email notifications (choose ONE) ─────────────────────────────────────
# Where booking / estimate / contact notifications are sent (default: emiliscleaningco@gmail.com)
NOTIFY_EMAIL=emiliscleaningco@gmail.com

# Option A — Gmail: create an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=emiliscleaningco@gmail.com
GMAIL_APP_PASSWORD=

# Option B — Resend (https://resend.com) with a verified domain
RESEND_API_KEY=
MAIL_FROM="Emili's Cleaning Co. <hello@emiliscleaningco.com>"

# Option C — any SMTP server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Google ────────────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification code (just the content="..." value)
GOOGLE_SITE_VERIFICATION=
